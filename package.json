{
  "name": "contact-sheet-generator",
  "version": "3.2.0",
  "description": "Desktop app to generate contact sheets from image folders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:universal": "electron-builder --mac --universal",
    "build:arm64": "electron-builder --mac --arm64",
    "build:x64": "electron-builder --mac --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "contact-sheet",
    "photography",
    "image-processing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "sharp": "^0.33.1"
  },
  "build": {
    "appId": "com.contactsheet.generator",
    "productName": "Contact Sheet Generator",
    "icon": "assets/icon-1024.png",
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Contact Sheet Generator ${version}",
      "icon": "assets/dmg-icon.icns",
      "background": "assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 144,
          "y": 200,
          "type": "file"
        },
        {
          "x": 396,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "services/**/*",
      "utils/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/canvas/**/*",
      "assets/**/*"
    ],
    "afterPack": "./afterPack.js"
  }
}
